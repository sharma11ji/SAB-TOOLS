rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function own(uid){return signedIn()&&request.auth.uid==uid;}
  function validTimestamps(){return request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;}
  match /users/{uid}{
   allow read,create,update: if own(uid);
   allow delete: if false;
   match /{sub=**}/{docId}{
    allow read,delete: if own(uid);
    allow create,update: if own(uid) && validTimestamps();
   }
  }
 }
}